# ------------------------------------------------------------------------------
# PostgreSQL Database (Auth DB)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ProyectoDB
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_ISSUER=AuthService
JWT_AUDIENCE=ProyectoClient

JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# MinIO Object Storage
# ------------------------------------------------------------------------------
# MinIO Root Administrator (Console & S3 Master)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_root_password_123

# Optional public endpoint URL override for MinIO. Default is unset (allows requests from any host/IP)
# MINIO_SERVER_URL=

# Dedicated Application User (created automatically by minio-init)
MINIO_SERVICE_USER=backend-service
MINIO_SERVICE_USER_PASSWORD=change_this_service_user_password!

# Static Service Account / Access Keys for backend applications
# Note: Access key length must be between 3 and 20 characters
MINIO_SVCACCT_ACCESS_KEY=bknd-svc-key
MINIO_SVCACCT_SECRET_KEY=change_this_service_secret_key_at_least_8_chars

# Default bucket to create automatically
MINIO_DEFAULT_BUCKET=images
